<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>POS System | @ViewData["Title"]</title>

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="~/lib/adminlte/plugins/fontawesome-free/css/all.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="~/lib/adminlte/dist/css/adminlte.min.css">
    <!-- Sweet Alert -->
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css">
</head>
<body class="hold-transition sidebar-mini">
    <div class="wrapper">

     

        <!-- 1. Top Navbar (Header) မလာခင် နေရာ -->
        @await Html.PartialAsync("_Navbar")

        <!-- 2. Main Sidebar (ဘယ်ဘက် Menu) နေရာ -->
        @await Html.PartialAsync("_Sidebar")

        <!-- 3. Content Wrapper (အလယ်က အဓိက အပြောင်းအလဲဖြစ်မည့် နေရာ) -->
        <div class="content-wrapper">
            <section class="content p-1">
                <div class="container-fluid">
                    <!-- သက်ဆိုင်ရာ View များ၏ ကုဒ်များ ဝင်လာမည့်နေရာ -->
                    @RenderBody()
                </div>
            </section>
        </div>

        <!-- 4. Footer နေရာ -->
        <footer class="main-footer">
            <strong>Copyright &copy; 2026 <a href="#">Paii POS System</a>.</strong> All rights reserved.
        </footer>

    </div>
    <!-- ./wrapper -->
    <!-- REQUIRED SCRIPTS -->
    <!-- jQuery -->
    <script src="~/lib/adminlte/plugins/jquery/jquery.min.js"></script>
    <!-- Bootstrap 4 -->
    <script src="~/lib/adminlte/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE App -->
    <script src="~/lib/adminlte/dist/js/adminlte.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>

    <script>
        $(document).ready(function () {

            $(document).on('click', '.swal-delete', function (e) {
                e.preventDefault(); 

                var url = $(this).attr('href');
                var form = $(this).closest('form'); 

                Swal.fire({
                    title: 'Are you sure?',
                    text: "This action cannot be undone!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545', 
                    cancelButtonColor: '#6c757d', 
                    confirmButtonText: '<i class="fas fa-trash-alt mr-1"></i> Yes, delete it!'
                }).then((result) => {
                   
                    if (result.isConfirmed) {
                        if (form.length > 0) {
                            form.submit(); 
                        } else if (url) {
                            window.location.href = url; 
                        }
                    }
                });
            });

            
            $(document).on('click', '.swal-logout', function (e) {
                e.preventDefault();

                var url = $(this).attr('href');
                var form = $(this).closest('form');

                Swal.fire({
                    title: 'Ready to Leave?',
                    text: "Select 'Logout' below if you are ready to end your current session.",
                    icon: 'question', 
                    showCancelButton: true,
                    confirmButtonColor: '#007bff',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="fas fa-sign-out-alt mr-1"></i> Logout'
                }).then((result) => {
                    if (result.isConfirmed) {
                        if (form.length > 0) {
                            form.submit();
                        } else if (url) {
                            window.location.href = url;
                        }
                    }
                });
            });

            $(document).on('click', '.swal-void', function (e) {
                e.preventDefault();

                var url = $(this).attr('href');
                var form = $(this).closest('form');

                Swal.fire({
                    title: 'Are you sure to void this sale?',
                    text: "Select 'Void' below if you are ready to void this sale.",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="fas fa-ban mr-1"></i> Void'
                }).then((result) => {
                    if (result.isConfirmed) {
                        if (form.length > 0) {
                            form.submit();
                        } else if (url) {
                            window.location.href = url;
                        }
                    }
                });
            });

        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>