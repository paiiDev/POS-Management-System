@using POS.Shared.Extensions

@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}

<!-- Main Sidebar Container -->
<aside class="main-sidebar sidebar-dark-primary elevation-4">


    <!-- Sidebar -->
    <div class="sidebar">
        <!-- Sidebar user panel (optional) -->
        <div class="user-panel mt-3 pb-3 mb-3 d-flex align-items-center">
            <div class="image" style="padding-left: 20px;">
                @if(User.IsInRole("Admin")){
                <i class="fas fa-user-tie fa-lg text-light"></i>
                } else if(User.IsInRole("Manager")) {
                <i class="fas fa-user-cog fa-lg text-light"></i>
                } else {
                <i class="fas fa-user fa-lg text-light"></i>
                }
               
            </div>
            <div class="info">
                <div class="d-flex">
                    <a href="#" class="d-block fs-1">
                        @User.GetFullName() 
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <span class="text-blue"></span>
                    }
                    else if (User.IsInRole("Manager"))
                    {
                        <span class="text-white">&nbsp;| &nbsp; </span>
                        <span class="text-blue"> Manager </span>
                    }
                    else
                    {
                        <span class="text-white">&nbsp;| &nbsp; </span>
                        <span class="text-blue"> Cashier </span>
                    }
                </div>
               
            </div>
        </div>
    

        <!-- Sidebar Menu -->
        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">

                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a href="/" class="nav-link @(currentController == "Home" ? "active" : "")">
                            <i class="nav-icon fas fa-tachometer-alt"></i>
                            <p>Dashboard</p>
                        </a>
                    </li>
                }

                <li class="nav-item">
                    <a asp-controller="Sale" asp-action="CreateSale" class="nav-link @(currentController == "Sale" && currentAction == "CreateSale" ? "active" : "")">
                        <i class="nav-icon fas fa-shopping-cart"></i>
                        <p>Create Sale</p>
                    </a>
                </li>

         
              
                <li class="nav-item">
                    <form asp-controller="Product" asp-action="Index">
                        <a asp-controller="Product" asp-action="Index" class="nav-link @(currentController == "Product" ? "active" : "")">
                            <i class="nav-icon fas fa-box"></i>
                            <p>Product Management</p>
                        </a>
                    </form>

                </li>

                <li class="nav-item">
                    <a asp-controller="Category" asp-action="Index" class="nav-link @(currentController == "Category" ? "active" : "")">
                        <i class="nav-icon fas fa-tags"></i>
                        <p>Category Management</p>
                    </a>
                </li>

             


                <li class="nav-item">
                    <a asp-controller="Sale" asp-action="ViewSaleTransactions" class="nav-link @(currentController == "Sale" && currentAction == "ViewSaleTransactions" ? "active" : "")">
                        <i class="nav-icon fas fa-receipt" style="color: rgb(255, 255, 255);"></i>
                        <p>Sale Transaction</p>
                    </a>
                </li>


               

        

                @if(User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <li class="nav-item">
                        <a asp-controller="Sale" asp-action="VoidedSaleTransactions" class="nav-link @(currentController == "Sale" && currentAction == "VoidedSaleTransactions" ? "active" : "")">
                            <i class="nav-icon fas fa-ban" style="color: rgb(255, 255, 255);"></i>
                            <p>Voided Sales</p>
                        </a>
                    </li>
                }

                @if(User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a asp-controller="User" asp-action="Index" class="nav-link @(currentController == "User" ? "active" : "")">
                            <i class="nav-icon fas fa-users"></i>
                            <p>User Management</p>
                        </a>
                    </li>
                }


            </ul>
        </nav>
        <!-- /.sidebar-menu -->
    </div>
    <!-- /.sidebar -->
</aside>