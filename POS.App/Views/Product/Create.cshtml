@using POS.Shared.DTOs.Product
@model CreateProductDto

@{
    ViewData["Title"] = "Create Product";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card card-primary card-outline shadow-sm">

                <div class="card-header">
                    <h3 class="card-title font-weight-bold">
                        <i class="fas fa-box-open mr-2"></i> Create New Product
                    </h3>
                </div>

                <form asp-action="Create" method="post">
                    <div class="card-body">

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label font-weight-normal"></label>
                                <input asp-for="Name" class="form-control" placeholder="Enter product name" />
                                <span asp-validation-for="Name" class="text-danger text-sm"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="CategoryId" class="form-label font-weight-normal"></label>
                                <select asp-for="CategoryId" class="form-control select2">
                                    <option value="">-- Select Category --</option>
                                    @if (ViewBag.Categories != null && ViewBag.Categories.Count > 0)
                                    {
                                        @foreach (var category in ViewBag.Categories)
                                        {
                                            <option value="@category.Id">@category.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger text-sm"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Barcode" class="form-label font-weight-normal"></label>
                                <input asp-for="Barcode" class="form-control" placeholder="Scan or enter barcode" />
                                <span asp-validation-for="Barcode" class="text-danger text-sm"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="StockQuantity" class="form-label font-weight-normal"></label>
                                <input asp-for="StockQuantity" type="number" class="form-control" placeholder="0" />
                                <span asp-validation-for="StockQuantity" class="text-danger text-sm"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CostPrice" class="form-label font-weight-normal"></label>
                                <div class="input-group">
                                    <input asp-for="CostPrice" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                    <div class="input-group-append">
                                        <span class="input-group-text">Ks</span>
                                    </div>
                                </div>
                                <span asp-validation-for="CostPrice" class="text-danger text-sm"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="SellingPrice" class="form-label font-weight-normal"></label>
                                <div class="input-group">
                                    <input asp-for="SellingPrice" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                    <div class="input-group-append">
                                        <span class="input-group-text">Ks</span>
                                    </div>
                                </div>
                                <span asp-validation-for="SellingPrice" class="text-danger text-sm"></span>
                            </div>
                        </div>

                    </div>
                    <div class="card-footer bg-light text-right">
                        <a asp-action="Index" class="btn btn-secondary mr-2">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Save Product
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}