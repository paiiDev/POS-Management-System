@model POS.Shared.DTOs.Product.ProductDto

<div class="container mt-4">

    <h2 class="text-danger mb-4">
        Delete Product
    </h2>

    <div class="alert alert-warning">

        Are you sure you want to delete this product?

    </div>

    <div class="card">

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">
                    Id
                </dt>

                <dd class="col-sm-9">
                    @Model.Id
                </dd>

                <dt class="col-sm-3">
                    Name
                </dt>

                <dd class="col-sm-9">
                    @Model.Name
                </dd>

                <dt class="col-sm-3">
                    Barcode
                </dt>

                <dd class="col-sm-9">
                    @Model.Barcode
                </dd>

                <dt class="col-sm-3">
                    Price
                </dt>

                <dd class="col-sm-9">
                    @Model.Price
                </dd>

                <dt class="col-sm-3">
                    Stock Quantity
                </dt>

                <dd class="col-sm-9">
                    @Model.StockQuantity
                </dd>

                <dt class="col-sm-3">
                    Category
                </dt>

                <dd class="col-sm-9">
                    @Model.CategoryName
                </dd>

            </dl>

            <form asp-action="ConfirmedDelete" method="post">

                <!-- Hidden Id -->
                <input asp-for="Id" type="hidden" />

                <button type="submit"
                        class="btn btn-danger">

                    Delete

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>