@using POS.Shared.DTOs.Product
@model ProductDto

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="alert alert-danger shadow-sm border-0 mb-4" role="alert">
                <i class="fas fa-exclamation-triangle mr-2"></i>
                <strong>Warning!</strong> Are you sure you want to delete this product? This action cannot be undone.
            </div>

            <div class="card card-danger card-outline shadow-sm border-0">

                <div class="card-header bg-transparent">
                    <h3 class="card-title font-weight-bold m-0 text-danger">
                        <i class="fas fa-trash-alt mr-2"></i> Delete Product
                    </h3>
                </div>

                <div class="card-body">
                    <div class="bg-light p-4 rounded">
                        <dl class="row mb-0 text-md">
                            <dt class="col-sm-5 text-muted mb-2">Product ID</dt>
                            <dd class="col-sm-7 font-weight-bold mb-2">#@Model.Id</dd>

                            <dt class="col-sm-5 text-muted mb-2">Name</dt>
                            <dd class="col-sm-7 font-weight-bold text-dark mb-2">@Model.Name</dd>

                            <dt class="col-sm-5 text-muted mb-2">Barcode</dt>
                            <dd class="col-sm-7 mb-2"><i class="fas fa-barcode mr-1 text-muted"></i> @Model.Barcode</dd>

                            <dt class="col-sm-5 text-muted mb-2">Cost Price</dt>
                            <dd class="col-sm-7 mb-2">@Model.CostPrice.ToString("#,##0") Ks</dd>

                            <dt class="col-sm-5 text-muted mb-2">Selling Price</dt>
                            <dd class="col-sm-7 text-success font-weight-bold mb-2">@Model.SellingPrice.ToString("#,##0") Ks</dd>

                            <dt class="col-sm-5 text-muted mb-2">Stock Quantity</dt>
                            <dd class="col-sm-7 mb-2">
                                @if (Model.StockQuantity == 0)
                                {
                                    <span class="badge badge-danger px-2 py-1 shadow-sm">Out of Stock</span>
                                }
                                else
                                {
                                    <span class="badge badge-info px-2 py-1 shadow-sm">@Model.StockQuantity In Stock</span>
                                }
                            </dd>

                            <dt class="col-sm-5 text-muted mb-0">Category</dt>
                            <dd class="col-sm-7 mb-0">
                                <span class="badge badge-secondary px-2 py-1 shadow-sm">@Model.CategoryName</span>
                            </dd>
                        </dl>
                    </div>
                </div>

                <div class="card-footer bg-white text-right border-top-0 pt-0 pb-3">
                    <form asp-action="ConfirmedDelete" method="post">

                        <input asp-for="Id" type="hidden" />

                        <a asp-action="Index" class="btn btn-secondary mr-2 shadow-sm">
                            <i class="fas fa-times mr-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-danger shadow-sm font-weight-bold swal-delete">
                            <i class="fas fa-trash-alt mr-1"></i> Confirm Delete
                        </button>

                    </form>
                </div>

            </div>
        </div>
    </div>
</div>