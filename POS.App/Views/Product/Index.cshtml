@model List<POS.Shared.DTOs.Product.ProductDto>

@{
    ViewData["Title"] = "Product List";
}

<div class="container-fluid mt-4">

    <div class="row align-items-center mb-4">
        <div class="col-sm-6">
            <h3 class="m-0 text-dark font-weight-bold">
                <i class="fas fa-boxes mr-2 text-primary"></i> Product Inventory
            </h3>
        </div>
        <div class="col-sm-6 text-right mt-3 mt-sm-0">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-primary shadow-sm">
                    <i class="fas fa-plus-circle mr-1"></i> Create Product
                </a>
            }
        </div>
    </div>

    <div class="card card-primary card-outline shadow-sm border-0">
        <div class="card-body p-0">

            @if (Model == null || !Model.Any())
            {
                <div class="py-5 text-center text-muted">
                    <i class="fas fa-box-open fa-3x mb-3 text-light"></i>
                    <h5 class="font-weight-normal">No products found.</h5>
                    <p class="small">Start adding new products to your inventory.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0 text-nowrap">

                        <thead class="bg-light">
                            <tr>
                                <th class="border-top-0 text-muted">ID</th>
                                <th class="border-top-0 text-muted">Product Info</th>
                                @if (User.IsInRole("Admin"))
                                {
                                    <th class="border-top-0 text-muted text-right">Cost Price</th>
                                }
                                <th class="border-top-0 text-muted text-right">Selling Price</th>
                                <th class="border-top-0 text-muted text-center">Stock</th>
                                <th class="border-top-0 text-muted text-center">Category</th>
                                @if (User.IsInRole("Admin"))
                                {
                                    <th class="border-top-0 text-muted text-center" width="120">Actions</th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-muted">#@item.Id</td>

                                    <td>
                                        <div class="font-weight-bold text-dark">@item.Name</div>
                                        <small class="text-muted"><i class="fas fa-barcode mr-1"></i>@item.Barcode</small>
                                    </td>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <td class="text-right">
                                            @item.CostPrice.ToString("#,##0") <small class="text-muted">Ks</small>
                                        </td>
                                    }

                                    <td class="text-right font-weight-bold text-success">
                                        @item.SellingPrice.ToString("#,##0") <small class="text-muted">Ks</small>
                                    </td>

                                    <td class="text-center">
                                        @if (item.StockQuantity == 0)
                                        {
                                            <span class="badge badge-danger px-2 py-1 shadow-sm"><i class="fas fa-exclamation-circle mr-1"></i>Out of Stock</span>
                                        }
                                        else if (item.StockQuantity < 5)
                                        {
                                            <span class="badge badge-warning px-2 py-1 shadow-sm">@item.StockQuantity Left</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-info px-2 py-1 shadow-sm">@item.StockQuantity In Stock</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <span class="badge badge-secondary px-2 py-1">@item.CategoryName</span>
                                    </td>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <td class="text-center">
                                            <div class="btn-group" role="group">
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>

        @if (Model != null && Model.Any())
        {
            <div class="card-footer bg-white text-muted text-sm border-top-0">
                Showing @Model.Count products in inventory.
            </div>
        }

    </div>
</div>