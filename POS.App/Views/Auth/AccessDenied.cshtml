@{
    ViewData["Title"] = "Access Denied - POS System";
    Layout = null; // Layout အလွတ်ဖြင့် သီးသန့် မျက်နှာပြင်အဖြစ် ပြသမည်
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        /* Login Page နှင့် လိုက်ဖက်သော Background Style */
        body {
            background-color: #f4f6f9;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .access-denied-card {
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            background-color: white;
            padding: 50px 40px;
            text-align: center;
            max-width: 500px;
            width: 90%;
            border-top: 5px solid #dc3545; /* အနီရောင် Accent လိုင်း */
        }

        .lock-icon {
            font-size: 5rem;
            color: #dc3545;
            margin-bottom: 20px;
            animation: shake 0.5s ease-in-out;
        }

        .error-code {
            font-size: 1.2rem;
            font-weight: bold;
            color: #dc3545;
            letter-spacing: 2px;
            margin-bottom: 5px;
        }

        /* Icon လေး ခါယမ်းသွားစေမည့် Animation */
        @@keyframes shake {
            0% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            50% { transform: translateX(10px); }
            75% { transform: translateX(-10px); }
            100% { transform: translateX(0); }
        }
    </style>
</head>
<body>

    <div class="access-denied-card">

        <i class="fas fa-lock lock-icon"></i>

        <div class="error-code">ERROR 403</div>

        <h2 class="fw-bold mb-3 text-dark">Access Denied</h2>
        <p class="text-muted mb-4">
            Sorry, you do not have the required permissions to view this page. Please contact the system Administrator if you believe this is a mistake.
        </p>

        <div class="d-flex justify-content-center gap-3 mt-4">
            <button onclick="history.back()" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                Go Back
            </button>

           
        </div>

    </div>

</body>
</html>