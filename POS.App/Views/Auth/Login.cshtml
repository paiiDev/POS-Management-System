@using POS.Shared.DTOs.Auth
@model LoginDto

@{
    ViewData["Title"] = "Login";
}


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5 col-xl-4">

            <div class="card login-card border-0">

                <div class="login-header">
                    <i class="fas fa-store fa-3x mb-3"></i>
                    <h3 class="fw-bold mb-0 text-center">POS System</h3>
                    <p class="text-white-50 mb-0 mt-1">Welcome back! Please log in.</p>
                </div>

                <div class="login-body">

                    @if (!string.IsNullOrWhiteSpace(ViewBag.Error))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i> @ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-controller="Auth" asp-action="Login" method="post">


                        <div class="mb-4">
                            <label asp-for="Username" class="form-label fw-semibold text-secondary">Username</label>
                            <div class="input-group">
                                <span class="input-group-text text-muted"><i class="fas fa-user"></i></span>
                                <input asp-for="Username" class="form-control" placeholder="Enter username" autocomplete="off" />
                            </div>
                            <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-semibold text-secondary">Password</label>
                            <div class="input-group">
                                <span class="input-group-text text-muted"><i class="fas fa-lock"></i></span>
                                <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-grid mt-5">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold rounded-pill">
                                <i class="fas fa-sign-in-alt me-2"></i> Login
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>



@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
