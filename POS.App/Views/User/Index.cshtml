@using POS.Shared.DTOs.User

@model List<UserDto>

@{
    ViewData["Title"] = "User Management";
}

<div class="container mt-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill text-primary"></i> User Management</h2>
        <a asp-action="CreateUser" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Add New User
        </a>
    </div>



    <!-- Data Table Section -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Username</th>
                            <th>Full Name</th>
                            <th>Role</th>
                            <th>Created At</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var user in Model)
                            {
                                <tr>
                                    <td class="ps-4">@user.Id</td>
                                    <td class="fw-bold">@user.UserName</td>
                                    <td>@user.FullName</td>
                                    <td>
                                        @if (user.Role == "Admin")
                                        {
                                            <span class="badge bg-danger">@user.Role</span>
                                        }
                                        else if (user.Role == "Cashier")
                                        {
                                            <span class="badge bg-success">@user.Role</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@user.Role</span>
                                        }
                                    </td>
                                    <td>@user.CreatedAt.ToString("MMM dd, yyyy, h:s tt")</td>
                                    <td class="text-center pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    No users found. Click "Add New User" to create one.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>