@using POS.Shared.DTOs.Pagination
@using POS.Shared.DTOs.User
@model PagedResult<UserDto>

@{
    ViewData["Title"] = "User Management";
    ViewData["Icon"] = "nav-icon fas fa-users text-primary";
    int rowNo = (Model.PageNumber - 1) * Model.PageSize + 1;
}

<div class="container-fluid mt-4">

    <div class="row align-items-center mb-4">
        <div class="col-sm-6">
           
        </div>
        <div class="col-sm-6 text-right mt-3 mt-sm-0">
            <a asp-action="CreateUser" class="btn btn-primary shadow-sm">
                <i class="fas fa-user-plus mr-1"></i> Add New User
            </a>
        </div>
    </div>

    <div class="card card-primary card-outline shadow-sm border-0">
        <div class="card-body p-0">

            @if (Model == null || !Model.Items.Any())
            {
                <div class="py-5 text-center text-muted">
                    <i class="fas fa-user-slash fa-3x mb-3 text-light"></i>
                    <h5 class="font-weight-normal">No users found.</h5>
                    <p class="small">Click "Add New User" to create the first user in the system.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0 text-nowrap">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-top-0 text-muted ps-4" width="80">ID</th>
                                <th class="border-top-0 text-muted">User Info</th>
                                <th class="border-top-0 text-muted text-center">Role</th>
                                <th class="border-top-0 text-muted">Created At</th>
                                <th class="border-top-0 text-muted text-center pe-4" width="120">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">#@rowNo</td>

                                    <td>
                                        <div class="font-weight-bold text-dark">@user.FullName</div>
                                        <small class="text-muted"><i class="fas fa-user-circle mr-1"></i>@user.UserName</small>
                                    </td>

                                    <td class="text-center">
                                        @if (user.Role == "Admin")
                                        {
                                            <span class="badge badge-danger px-2 py-1 shadow-sm">
                                                <i class="fas fa-user-shield mr-1"></i> @user.Role
                                            </span>
                                        }
                                        else if (user.Role == "Cashier")
                                        {
                                            <span class="badge badge-success px-2 py-1 shadow-sm">
                                                <i class="fas fa-cash-register mr-1"></i> @user.Role
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary px-2 py-1 shadow-sm">@user.Role</span>
                                        }
                                    </td>

                                    <td>
                                        <div class="text-dark"><i class="far fa-calendar-alt text-muted mr-1"></i> @user.CreatedAt.ToString("MMM dd, yyyy")</div>
                                        <small class="text-muted"><i class="far fa-clock mr-1"></i> @user.CreatedAt.ToString("hh:mm tt")</small>
                                    </td>

                                    <td class="text-center pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning shadow-sm" title="Edit User">
                                                <i class="fas fa-user-edit"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger shadow-sm" title="Delete User">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>

                                rowNo++;
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @if (Model != null && Model.TotalPages > 0)
        {
            <div class="card-footer bg-white border-top-0 d-flex flex-column flex-sm-row justify-content-between align-items-center">

                <div class="text-muted text-sm mb-2 mb-sm-0">
                    Showing Page <strong>@Model.PageNumber</strong> of <strong>@Model.TotalPages</strong>
                    (Total @Model.TotalCount items)
                </div>

                <nav aria-label="Product pagination">
                    <ul class="pagination pagination-sm m-0">

                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)">Previous</a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                            </li>
                        }

                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)">Next</a>
                        </li>

                    </ul>
                </nav>

            </div>
        }
    </div>
</div>