@using POS.Shared.DTOs.User
@model CreateUserDto

@{
    ViewData["Title"] = "Create User";
    ViewData["Icon"] = "fas fa-user-plus mr-2 text-primary";
    ViewData["ParentTitle"] = "User Management";
    ViewData["ParentUrl"] = "/User/Index";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            @if (!string.IsNullOrWhiteSpace(ViewBag.Error))
            {
                <div class="alert alert-danger shadow-sm border-0 mb-4" role="alert">
                    <i class="fas fa-exclamation-triangle mr-2"></i> @ViewBag.Error
                </div>
            }

            <div class="card card-primary card-outline shadow-sm border-0">

                <div class="card-header bg-transparent">
                    <h4 class="card-title font-weight-bold m-0">
                        Create New User
                    </h4>
                </div>

                <form asp-action="CreateUser" method="post">
                    <div class="card-body">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-3">
                            <label asp-for="FullName" class="form-label font-weight-normal">Full Name</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light"><i class="fas fa-id-card text-muted"></i></span>
                                </div>
                                <input asp-for="FullName" class="form-control" placeholder="Enter full name" autofocus />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger text-sm mt-1 d-block"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="UserName" class="form-label font-weight-normal">Username</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light"><i class="fas fa-user text-muted"></i></span>
                                </div>
                                <input asp-for="UserName" class="form-control" placeholder="Enter login username" />
                            </div>
                            <span asp-validation-for="UserName" class="text-danger text-sm mt-1 d-block"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="PasswordHash" class="form-label font-weight-normal">Password</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light"><i class="fas fa-lock text-muted"></i></span>
                                    </div>
                                    <input asp-for="PasswordHash" type="password" class="form-control" placeholder="Enter password" />
                                </div>
                                <span asp-validation-for="PasswordHash" class="text-danger text-sm mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="ConfirmPassword" class="form-label font-weight-normal">Confirm Password</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light"><i class="fas fa-check-circle text-muted"></i></span>
                                    </div>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm password" />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger text-sm mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="form-group mb-0">
                            <label asp-for="Role" class="form-label font-weight-normal">User Role</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light"><i class="fas fa-user-tag text-muted"></i></span>
                                </div>
                                <select asp-for="Role" class="form-control">
                                    <option value="">-- Select Role --</option>
                                    <option value="Admin">Admin</option>
                                    <option value="Cashier">Cashier</option>
                                </select>
                            </div>
                            <span asp-validation-for="Role" class="text-danger text-sm mt-1 d-block"></span>
                        </div>

                    </div>

                    <div class="card-footer bg-light text-right border-top-0">
                        <a asp-action="Index" class="btn btn-secondary mr-2 shadow-sm">
                            <i class="fas fa-times mr-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary shadow-sm font-weight-bold">
                            <i class="fas fa-save mr-1"></i> Save User
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}