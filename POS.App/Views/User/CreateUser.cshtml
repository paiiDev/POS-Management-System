@using POS.Shared.DTOs.User
@model UserDto

@{
    ViewData["Title"] = "Delete User";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="alert alert-danger shadow-sm border-0 mb-4" role="alert">
                <i class="fas fa-exclamation-triangle mr-2"></i>
                <strong>Warning!</strong> Are you sure you want to delete this user? This action cannot be undone.
            </div>

            <div class="card card-danger card-outline shadow-sm border-0">

                <div class="card-header bg-transparent">
                    <h4 class="card-title font-weight-bold m-0 text-danger">
                        <i class="fas fa-user-times mr-2"></i> Delete User
                    </h4>
                </div>

                <div class="card-body">
                    <div class="bg-light p-4 rounded mb-0 text-center text-sm-left">
                        <dl class="row mb-0 text-md">

                            <dt class="col-sm-5 text-muted mb-2">User ID</dt>
                            <dd class="col-sm-7 font-weight-bold mb-2">#@Model.Id</dd>

                            <dt class="col-sm-5 text-muted mb-2">Full Name</dt>
                            <dd class="col-sm-7 font-weight-bold text-dark mb-2">
                                <i class="fas fa-id-card mr-1 text-muted"></i> @Model.FullName
                            </dd>

                            <dt class="col-sm-5 text-muted mb-2">Username</dt>
                            <dd class="col-sm-7 mb-2">
                                <i class="fas fa-user mr-1 text-muted"></i> @Model.UserName
                            </dd>

                            <dt class="col-sm-5 text-muted mb-0">Role</dt>
                            <dd class="col-sm-7 mb-0">
                                @if (Model.Role == "Admin")
                                {
                                    <span class="badge badge-danger px-2 py-1 shadow-sm">
                                        <i class="fas fa-user-shield mr-1"></i> @Model.Role
                                    </span>
                                }
                                else if (Model.Role == "Cashier")
                                {
                                    <span class="badge badge-success px-2 py-1 shadow-sm">
                                        <i class="fas fa-cash-register mr-1"></i> @Model.Role
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary px-2 py-1 shadow-sm">@Model.Role</span>
                                }
                            </dd>

                        </dl>
                    </div>
                </div>

                <div class="card-footer bg-white text-right border-top-0 pt-0 pb-3">
                    <form asp-action="Delete" method="post">

                        <input type="hidden" asp-for="Id" />

                        <a asp-action="Index" class="btn btn-secondary mr-2 shadow-sm">
                            <i class="fas fa-times mr-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-danger shadow-sm font-weight-bold">
                            <i class="fas fa-trash-alt mr-1"></i> Confirm Delete
                        </button>

                    </form>
                </div>

            </div>
        </div>
    </div>
</div>