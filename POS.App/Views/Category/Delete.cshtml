@using POS.Shared.DTOs.Category
@model CategoryDto

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="alert alert-danger shadow-sm border-0 mb-4" role="alert">
                <i class="fas fa-exclamation-triangle mr-2"></i>
                <strong>Warning!</strong> Are you sure you want to delete this category?
            </div>

            <!-- Delete Confirmation Card -->
            <div class="card card-danger card-outline shadow-sm border-0">

                <div class="card-header bg-transparent">
                    <h4 class="card-title font-weight-bold m-0 text-danger">
                        <i class="fas fa-trash-alt mr-2"></i> Delete Category
                    </h4>
                </div>

                <div class="card-body">
                    <div class="bg-light p-4 rounded mb-0 text-center text-sm-left">
                        <dl class="row mb-0 text-md">

                            <dt class="col-sm-5 text-muted mb-2">Category ID</dt>
                            <dd class="col-sm-7 font-weight-bold mb-2">#@Model.Id</dd>

                            <dt class="col-sm-5 text-muted mb-0">Name</dt>
                            <dd class="col-sm-7 font-weight-bold text-dark mb-0">
                                <i class="fas fa-tag mr-1 text-muted"></i> @Model.Name
                            </dd>

                        </dl>
                    </div>
                </div>

                <div class="card-footer bg-white text-right border-top-0 pt-0 pb-3">
                    <form asp-action="Delete" method="post">

                        <input type="hidden" asp-for="Id" />

                        <a asp-action="Index" class="btn btn-secondary mr-2 shadow-sm">
                            <i class="fas fa-times mr-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-danger shadow-sm font-weight-bold swal-delete">
                            <i class="fas fa-trash-alt mr-1"></i> Confirm Delete
                        </button>

                    </form>
                </div>

            </div>
        </div>
    </div>
</div>