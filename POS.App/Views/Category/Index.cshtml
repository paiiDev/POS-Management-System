@using POS.Shared.DTOs.Category
@using POS.Shared.DTOs.Pagination
@model PagedResult<CategoryDto>

@{
    ViewData["Title"] = "Category Management";
    ViewData["Icon"] = "fas fa-tags mr-2 text-primary";
}

<div class="container-fluid mt-4">

    <div class="row align-items-center mb-4">
        <div class="col-sm-6">
            <div class="row mb-3 mx-2">
                <div class="col-md-8 ">
                    <form asp-action="Index" method="get">
                        <div class="input-group">
                            <input type="text" name="searchString" value="@ViewBag.CurrentSearch"
                                   class="form-control" placeholder="Search by category name ...">

                            <div class="input-group-append">
                                <button class="btn btn-primary" type="submit">
                                    <i class="fas fa-search"></i> Search
                                </button>

                                @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
                                {
                                    <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Search">
                                        <i class="fas fa-times"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-sm-6 text-right mt-3 mt-sm-0">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-primary shadow-sm">
                    <i class="fas fa-plus-circle mr-1"></i> Create Category
                </a>
            }
        </div>
    </div>

    <div class="card card-primary card-outline shadow-sm border-0">
        <div class="card-body p-0">

            @if (Model == null || !Model.Items.Any())
            {
                <div class="py-5 text-center text-muted">
                    <i class="fas fa-folder-open fa-3x mb-3 text-light"></i>
                    <h5 class="font-weight-normal">No categories found.</h5>
                    <p class="small">Start adding new categories for your products.</p>
                </div>
            }
            else
            {
                int rowNo = (Model.PageNumber - 1) * Model.PageSize + 1;

                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0 text-nowrap">

                        <thead class="bg-light">
                            <tr>
                                <th class="border-top-0 text-muted" width="100">ID</th>
                                <th class="border-top-0 text-muted">Category Name</th>
                                @if (User.IsInRole("Admin"))
                                {
                                    <th class="border-top-0 text-muted text-center" width="150">Actions</th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="text-muted">#@rowNo</td>

                                    <td class="font-weight-bold text-dark">
                                        @item.Name
                                    </td>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <td class="text-center">
                                            <div class="btn-group" role="group">
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            </div>
                                        </td>
                                    }
                                </tr>

                                rowNo++;
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>

        @if (Model != null && Model.Items.Any())
        {
            <div class="card-footer bg-white border-top-0 d-flex flex-column flex-sm-row justify-content-between align-items-center">

                <div class="text-muted text-sm mb-2 mb-sm-0">
                    Showing Page <strong>@Model.PageNumber</strong> of <strong>@Model.TotalPages</strong>
                    (Total @Model.TotalCount items)
                </div>

                <nav aria-label="Product pagination">
                    <ul class="pagination pagination-sm m-0">

                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" asp-route-searchString="@ViewBag.CurrentSearch">Previous</a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchString="@ViewBag.CurrentSearch">@i</a>
                            </li>
                        }

                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" asp-route-searchString="@ViewBag.CurrentSearch">Next</a>
                        </li>

                    </ul>
                </nav>

            </div>
        }

    </div>
</div>