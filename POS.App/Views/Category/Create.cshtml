@using POS.Shared.DTOs.Category
@model CreateCategoryDto

@{
    ViewData["Title"] = "Create Category";
    ViewData["ParentTitle"] = "Category Management";
    ViewData["Icon"] = "fas fa-tags mr-2 text-primary";
    ViewData["ParentUrl"] = "/Category/Index";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card card-primary card-outline shadow-sm border-0">

                <div class="card-header bg-transparent">
                    <h4 class="card-title font-weight-bold m-0">
                        <i class="fas fa-folder-plus mr-2 text-primary"></i> Create New Category
                    </h4>
                </div>

                <form asp-action="Create" method="post">
                    <div class="card-body">

                        <div class="form-group mb-3">
                            <label asp-for="Name" class="form-label font-weight-normal">Category Name</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light"><i class="fas fa-tag text-muted"></i></span>
                                </div>
                                <input asp-for="Name" class="form-control" placeholder="Enter category name e.g. Beverages, Electronics..." autofocus />
                            </div>
                            <span asp-validation-for="Name" class="text-danger text-sm mt-1 d-block"></span>
                        </div>

                    </div>

                    <div class="card-footer bg-light text-right border-top-0">
                        <a asp-action="Index" class="btn btn-secondary mr-2 shadow-sm">
                            <i class="fas fa-times mr-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary shadow-sm">
                            <i class="fas fa-save mr-1"></i> Add Category
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}