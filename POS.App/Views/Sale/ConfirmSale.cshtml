@using POS.Shared.DTOs.Sales
@using System.Globalization

@model SaleDto

@{
    ViewData["Title"] = "Confirm Sale";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Sale Details</h2>

        <a asp-action="ViewSaleTransactions"
           class="btn btn-secondary">
            Sale Transactions
        </a>

    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Invoice Information</h5>
        </div>

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-4">
                    <label class="fw-bold">Invoice No</label>
                    <p>@Model.InvoiceNo</p>
                </div>

                <div class="col-md-4">
                    <label class="fw-bold">Sale Date</label>
                    <p>@Model.SaleDate.ToString("dd MMM yyyy hh:mm tt")</p>
                </div>

                <div class="col-md-4">
                    <label class="fw-bold">Total Amount</label>
                    <p class="fw-bold text-success">
                        @Model.TotalAmount.ToString("#,##0 Ks")
                    </p>
                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">Purchased Items</h5>
        </div>

        <div class="card-body">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th width="120">Unit Price</th>
                        <th width="120">Quantity</th>
                        <th width="150">Subtotal</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.Items)
                    {
                        <tr>

                            <td>
                                @item.ProductName
                            </td>

                            <td>
                                @item.UnitPrice.ToString("#,##0 Ks")
                            </td>

                            <td>
                                @item.Quantity
                            </td>

                            <td class="fw-bold">
                                @item.SubTotal.ToString("#,##0 Ks")
                            </td>

                        </tr>
                    }

                </tbody>

                <tfoot>

                    <tr>

                        <td colspan="3"
                            class="text-end fw-bold">
                            Grand Total
                        </td>

                        <td class="fw-bold text-success">
                            @Model.TotalAmount.ToString("#,##0 Ks")
                        </td>

                    </tr>

                </tfoot>

            </table>

            <div class="d-flex justify-content-between align-items-center mb-4">



                <a asp-action="ConfirmVoidSale"
                    asp-route-id="@Model.Id"
                   class="btn btn-danger w-25">
                    Void Sale
                </a>

                <a asp-action="CreateSale"
                   class="btn btn-success w-25">
                    Ok
                </a>

            </div>

        </div>

    </div>

</div>