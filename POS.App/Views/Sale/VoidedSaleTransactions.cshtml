@using POS.Shared.DTOs.Pagination
@using POS.Shared.DTOs.Sales
@using System.Globalization

@model PagedResult<SaleDto>

@{
    ViewData["Title"] = "Voided Sales";
    ViewData["Icon"] = "fas fa-file-excel mr-2 text-danger";
}

<div class="container-fluid mt-4">

    <div class="row align-items-center mb-4">
        <div class="col-sm-6">
            <div class="row mb-3 mx-2">
                <div class="col-md-8 ">
                    <form asp-action="VoidedSaleTransactions" method="get">
                        <div class="input-group">
                            <input type="text" name="searchString" value="@ViewBag.CurrentSearch"
                                   class="form-control" placeholder="Search by INV number ...">

                            <div class="input-group-append">
                                <button class="btn btn-primary" type="submit">
                                    <i class="fas fa-search"></i> Search
                                </button>

                                @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
                                {
                                    <a asp-action="VoidedSaleTransactions" class="btn btn-outline-secondary" title="Clear Search">
                                        <i class="fas fa-times"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ViewBag.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle mr-2"></i> @ViewBag.Error
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="card card-danger card-outline shadow-sm border-0">
        <div class="card-body p-0">

            @if (Model == null || !Model.Items.Any())
            {
                <div class="py-5 text-center text-muted">
                    <i class="fas fa-folder-open fa-3x mb-3 text-light"></i>
                    <h5 class="font-weight-normal">No voided sales found.</h5>
                    <p class="small">There are currently no cancelled or voided transactions in the system.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0 text-nowrap">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-top-0 text-muted">Invoice No</th>
                                <th class="border-top-0 text-muted">Date & Time</th>
                                <th class="border-top-0 text-muted text-right">Total Amount</th>
                                <th class="border-top-0 text-muted text-center">Status</th>
                                <th class="border-top-0 text-muted text-center" width="120">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sale in Model.Items)
                            {
                                <tr>
                                    <td class="font-weight-bold text-danger">
                                        #@sale.InvoiceNo
                                    </td>

                                    <td>
                                        <div class="text-dark"><i class="far fa-calendar-alt text-muted mr-1"></i> @sale.SaleDate.ToString("dd MMM yyyy")</div>
                                        <small class="text-muted"><i class="far fa-clock mr-1"></i> @sale.SaleDate.ToString("hh:mm tt")</small>
                                    </td>

                                    <td class="text-right font-weight-bold text-dark">
                                        @sale.TotalAmount.ToString("#,##0") <small class="text-muted">Ks</small>
                                    </td>

                                    <td class="text-center">
                                        <span class="badge badge-danger px-2 py-1 shadow-sm">
                                            <i class="fas fa-ban mr-1"></i> @sale.Status
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        <a asp-action="VoidedSaleDetails" asp-route-id="@sale.Id" class="btn btn-sm btn-outline-info shadow-sm" title="View Details">
                                            <i class="fas fa-eye mr-1"></i> Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @if (Model != null && Model.TotalPages > 0)
        {
            <div class="card-footer bg-white border-top-0 d-flex flex-column flex-sm-row justify-content-between align-items-center">

                <div class="text-muted text-sm mb-2 mb-sm-0">
                    Showing Page <strong>@Model.PageNumber</strong> of <strong>@Model.TotalPages</strong>
                    (Total @Model.TotalCount items)
                </div>

                <nav aria-label="Product pagination">
                    <ul class="pagination pagination-sm m-0">

                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="VoidedSaleTransactions" asp-route-page="@(Model.PageNumber - 1)" asp-route-searchString="@ViewBag.CurrentSearch">Previous</a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="VoidedSaleTransactions" asp-route-page="@i" asp-route-searchString="@ViewBag.CurrentSearch">@i</a>
                            </li>
                        }

                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="VoidedSaleTransactions" asp-route-page="@(Model.PageNumber + 1)" asp-route-searchString="@ViewBag.CurrentSearch">Next</a>
                        </li>

                    </ul>
                </nav>

            </div>
        }
    </div>

</div>