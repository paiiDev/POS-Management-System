@using POS.Shared.DTOs.VoidLog
@model VoidLogDetailsDto

@{
    ViewData["Title"] = "Void Log Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Void Log Details</h2>

        <a  asp-action="VoidedSaleTransactions"
           class="btn btn-secondary">
            Back
        </a>

    </div>

    <div class="card shadow-sm border-danger">

        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">Voided Sale Information</h5>
        </div>

        <div class="card-body">

            <div class="row mb-4">

                <div class="col-md-6">

                    <label class="fw-bold">
                        Invoice No
                    </label>

                    <p>@Model.InvoiceNo</p>

                </div>

                <div class="col-md-6">

                    <label class="fw-bold">
                        Voided Amount
                    </label>

                    <p class="text-danger fw-bold">
                        @Model.VoidedAmount.ToString("C")
                    </p>

                </div>

            </div>

            <div class="row mb-4">

                <div class="col-md-6">

                    <label class="fw-bold">
                        Cashier Name
                    </label>

                    <p>@Model.CashierName</p>

                </div>

                <div class="col-md-6">

                    <label class="fw-bold">
                        Voided At
                    </label>

                    <p>
                        @Model.VoidedAt.ToString("dd MMM yyyy hh:mm tt")
                    </p>

                </div>

            </div>

            <div class="mb-3">

                <label class="fw-bold">
                    Void Reason
                </label>

                <div class="border rounded p-3 bg-light">

                    @Model.Reason

                </div>

            </div>

        </div>

    </div>

</div>