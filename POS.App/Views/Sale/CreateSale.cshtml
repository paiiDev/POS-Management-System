@using POS.Shared.DTOs.Sales
@using POS.Shared.DTOs.Product

@model CreateSaleDto

@{
    ViewData["Title"] = "Create Sale";
    var products = ViewBag.Products as IEnumerable<ProductDto> ?? Enumerable.Empty<ProductDto>();
}

<style>
    /* Product Card Hover Effect များအတွက် Custom CSS */
    .product-card {
        transition: all 0.3s ease;
        border-radius: 12px;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.15) !important;
        }

    /* Scrollbar ကို သေးငယ်သပ်ရပ်အောင် ပြင်ဆင်ခြင်း */
    .custom-scroll::-webkit-scrollbar {
        width: 6px;
    }

    .custom-scroll::-webkit-scrollbar-thumb {
        background-color: #ced4da;
        border-radius: 10px;
    }

    .custom-scroll::-webkit-scrollbar-track {
        background-color: transparent;
    }
</style>

<div class="container-fluid mt-4">
    <div class="row">

        <div class="col-lg-7 col-xl-8 mb-4">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="m-0 text-dark font-weight-bold">
                    <i class="fas fa-boxes text-primary mr-2"></i> Products
                </h3>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm shadow-sm">
                    <i class="fas fa-arrow-left mr-1"></i> Back
                </a>
            </div>

            <div class="row custom-scroll" style="height: 75vh; overflow-y: auto; overflow-x: hidden; padding-right: 5px; padding-top: 5px;">
                @if (products.Any())
                {
                    @foreach (var product in products)
                    {
                        <div class="col-6 col-md-4 col-xl-3 mb-3">
                            <div class="card h-100 shadow-sm border-0 product-card"
                                 style="cursor: pointer;"
                                 onclick="addToCart(@product.Id, '@product.Name', @product.SellingPrice)">

                                <div class="card-body text-center d-flex flex-column justify-content-center p-3">
                                    <div class="mb-2">
                                        <i class="fas fa-box-open fa-2x text-info opacity-50"></i>
                                    </div>
                                    <h6 class="card-title text-dark font-weight-bold mb-1" style="font-size: 1rem;">@product.Name</h6>
                                    <p class="card-text text-success font-weight-bold mb-3" style="font-size: 0.95rem;">@product.SellingPrice.ToString("N0") Ks</p>

                                    <button class="btn btn-primary btn-sm mt-auto w-100 shadow-sm" style="border-radius: 20px;">
                                        <i class="fas fa-cart-plus mr-1"></i> Add
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="alert alert-info shadow-sm">
                            <i class="fas fa-info-circle mr-2"></i> No products available at the moment.
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-5 col-xl-4">

            <div class="sticky-top" style="top: 15px;">

                <form id="saleForm" asp-action="Create" method="post" class="card card-primary card-outline shadow-sm border-0 mb-4">

                    @if (!string.IsNullOrWhiteSpace(ViewBag.Error))
                    {
                        <div class="alert alert-danger mx-3 mt-3 mb-0" role="alert">
                            <i class="fas fa-exclamation-triangle mr-1"></i> @ViewBag.Error
                        </div>
                    }
                    <div asp-validation-summary="ModelOnly" class="text-danger mx-3 mt-3 mb-0"></div>

                    <div class="card-header bg-transparent border-bottom-0 pt-3 pb-2">
                        <h4 class="mb-0 font-weight-bold text-dark">
                            <i class="fas fa-shopping-basket text-primary mr-2"></i> Current Sale
                        </h4>
                    </div>

                    <div class="card-body p-0 custom-scroll" style="max-height: 50vh; overflow-y: auto;">
                        <table class="table table-hover mb-0 text-sm">
                            <thead class="bg-light sticky-top">
                                <tr>
                                    <th class="border-top-0 border-bottom-0 text-muted">Item</th>
                                    <th class="border-top-0 border-bottom-0 text-muted text-center" width="85">Qty</th>
                                    <th class="border-top-0 border-bottom-0 text-muted text-right">Subtotal</th>
                                    <th class="border-top-0 border-bottom-0" width="40"></th>
                                </tr>
                            </thead>
                            <tbody id="cartBody">
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-5">
                                        <i class="fas fa-shopping-cart fa-2x mb-3 text-light"></i><br />
                                        No items added yet.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="card-footer bg-white border-top">
                        <div class="d-flex justify-content-between align-items-center mb-3 p-3 rounded" style="background-color: #f8f9fa;">
                            <h5 class="m-0 font-weight-bold text-dark">Total:</h5>
                            <h4 class="m-0 font-weight-bold text-success" id="cartTotal">0 Ks</h4>
                        </div>

                        <div id="hiddenInputsContainer"></div>

                        <button type="submit" class="btn btn-success btn-lg btn-block shadow-sm font-weight-bold" id="btnCompleteSale" disabled style="border-radius: 8px;">
                            <i class="fas fa-check-circle mr-1"></i> Complete Sale
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        let cart = [];

        function addToCart(id, name, price) {
            const existingItem = cart.find(item => item.id === id);

            if (existingItem) {
                existingItem.qty += 1;
            } else {
                cart.push({ id: id, name: name, price: price, qty: 1 });
            }
            renderCart();
        }

        function updateQty(id, inputElement) {
            let newQty = parseInt(inputElement.value);

            if (isNaN(newQty) || newQty < 1) {
                newQty = 1;
                inputElement.value = 1;
            }

            const item = cart.find(item => item.id === id);
            if (item) {
                item.qty = newQty;
            }
            renderCart();
        }

        function removeFromCart(id) {
            cart = cart.filter(item => item.id !== id);
            renderCart();
        }

        function renderCart() {
            const cartBody = document.getElementById("cartBody");
            const cartTotal = document.getElementById("cartTotal");
            const btnCompleteSale = document.getElementById("btnCompleteSale");
            const hiddenInputsContainer = document.getElementById("hiddenInputsContainer");

            cartBody.innerHTML = "";
            hiddenInputsContainer.innerHTML = "";
            let totalAmount = 0;

            if (cart.length === 0) {
                cartBody.innerHTML = `
                    <tr>
                        <td colspan="4" class="text-center text-muted py-5">
                            <i class="fas fa-shopping-cart fa-2x mb-3 text-light"></i><br/>
                            No items added yet.
                        </td>
                    </tr>`;
                cartTotal.innerText = "0 Ks";
                btnCompleteSale.disabled = true;
                return;
            }

            btnCompleteSale.disabled = false;

            cart.forEach((item, index) => {
                let subtotal = item.price * item.qty;
                totalAmount += subtotal;

                // Cart Item များကို Modern Look ဖြင့် ဆွဲပါမည်
                const tr = document.createElement("tr");
                tr.innerHTML = `
                    <td class="align-middle">
                        <div class="font-weight-bold text-dark">${item.name}</div>
                        <small class="text-primary font-weight-bold">${item.price.toLocaleString()} Ks</small>
                    </td>
                    <td class="align-middle">
                        <input type="number" class="form-control form-control-sm text-center font-weight-bold"
                               value="${item.qty}" min="1" onchange="updateQty(${item.id}, this)">
                    </td>
                    <td class="align-middle text-right font-weight-bold text-dark">
                        ${subtotal.toLocaleString()}
                    </td>
                    <td class="align-middle text-center">
                        <button type="button" class="btn btn-sm text-danger" onclick="removeFromCart(${item.id})" style="background: none; border: none;" title="Remove Item">
                            <i class="fas fa-times-circle fa-lg"></i>
                        </button>
                    </td>
                `;
                cartBody.appendChild(tr);

                hiddenInputsContainer.innerHTML += `
                    <input type="hidden" name="Items.Index" value="${index}" />
                    <input type="hidden" name="Items[${index}].ProductId" value="${item.id}" />
                    <input type="hidden" name="Items[${index}].Quantity" value="${item.qty}" />
                `;
            });

            cartTotal.innerText = totalAmount.toLocaleString() + " Ks";
        }
    </script>
}