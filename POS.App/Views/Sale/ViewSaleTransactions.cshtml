@using POS.Shared.DTOs.Sales
@using System.Globalization


@model List<SaleDto>

@{
    ViewData["Title"] = "Sale Transactions";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Sales Transactions</h2>

        <a asp-action="CreateSale"
           class="btn btn-primary">
            Create Sale
        </a>

    </div>

    @if (!string.IsNullOrWhiteSpace(ViewBag.Error))
    {
        <div class="alert alert-danger" role="alert">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No sales transactions found.
        </div>
    }
    else
    {
       @*  <div class="card shadow-sm">

            <div class="card-body p-1">
                <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0"> *@

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">

                    <thead class="table-dark">
                        <tr>
                            <th>Invoice No</th>
                            <th>Date</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            @if (User.IsInRole("Admin"))
                            {
                                <th>Invoice By</th>

                            }
                            <th width="150">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var sale in Model)
                        {
                            <tr>

                                <td>
                                    @sale.InvoiceNo
                                </td>

                                <td>
                                    @sale.SaleDate.ToString("dd MMM yyyy hh:mm tt")
                                </td>

                                <td>
                                    @sale.TotalAmount.ToString("#,##0 Ks")
                                </td>

                                <td>
                                    @sale.Status
                                </td>

                                @if (User.IsInRole("Admin"))
                                {
                                    <td>
                                        @sale.CashierName
                                    </td>
                                }


                                    <td class="text-center pe-4">
                                        <div class="btn-group " role="group">
                                            <a asp-action="SaleDetails" asp-route-id="@sale.Id" class="btn btn-sm btn-outline-primary mx-2">
                                                Details
                                            </a>
                                            @if (User.IsInRole("Admin"))
                                            {
                                                {

                                                    <a asp-action="VoidSale"
                                                       asp-route-id="@sale.Id"
                                                       class="btn btn-danger btn-sm">
                                                        Void
                                                    </a>
                                                }
                                            }
                                            
                                        </div>
                                    </td>

                            </tr>
                        }

                    </tbody>

                </table>
                </div>

            </div>

        </div>
    }

</div>
