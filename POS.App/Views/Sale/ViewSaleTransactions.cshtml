@using POS.Shared.DTOs.Pagination
@using POS.Shared.DTOs.Sales
@using System.Globalization

@model PagedResult<SaleDto>

@{
    ViewData["Title"] =  "Sales Transactions";
    ViewData["Icon"] = "fas fa-file-invoice-dollar mr-2 text-primary";
    ;
}

<div class="container-fluid mt-4">

    <div class="row align-items-center mb-4">
        <div class="col-sm-6">
            <div class="row mb-3 mx-2">
                <div class="col-md-8 ">
                    <form asp-action="ViewSaleTransactions" method="get">
                        <div class="input-group">
                            <input type="text" name="searchString" value="@ViewBag.CurrentSearch"
                                   class="form-control" placeholder="Search by INV number ...">

                            <div class="input-group-append">
                                <button class="btn btn-primary" type="submit">
                                    <i class="fas fa-search"></i> Search
                                </button>

                                @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
                                {
                                    <a asp-action="ViewSaleTransactions" class="btn btn-outline-secondary" title="Clear Search">
                                        <i class="fas fa-times"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-sm-6 text-right mt-3 mt-sm-0">
            <a asp-action="CreateSale" class="btn btn-primary shadow-sm">
                <i class="fas fa-plus-circle mr-1"></i> Create New Sale
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ViewBag.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle mr-2"></i> @ViewBag.Error
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="card card-primary card-outline shadow-sm border-0">
        <div class="card-body p-0">

            @if (Model == null || !Model.Items.Any())
            {
                <div class="py-5 text-center text-muted">
                    <i class="fas fa-box-open fa-3x mb-3 text-light"></i>
                    <h5 class="font-weight-normal">No sales transactions found.</h5>
                    <p class="small">Start by creating a new sale to see records here.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0 text-nowrap">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-top-0 text-muted">Invoice No</th>
                                <th class="border-top-0 text-muted">Date & Time</th>
                                <th class="border-top-0 text-muted text-right">Total Amount</th>
                                <th class="border-top-0 text-muted text-center">Status</th>
                                @if (User.IsInRole("Admin"))
                                {
                                    <th class="border-top-0 text-muted">Cashier</th>
                                }
                                <th class="border-top-0 text-muted text-center" width="150">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sale in Model.Items)
                            {
                                <tr>
                                    <td class="font-weight-bold text-primary">
                                        #@sale.InvoiceNo
                                    </td>

                                    <td>
                                        <div class="text-dark"><i class="far fa-calendar-alt text-muted mr-1"></i> @sale.SaleDate.ToString("dd MMM yyyy")</div>
                                        <small class="text-muted"><i class="far fa-clock mr-1"></i> @sale.SaleDate.ToString("hh:mm tt")</small>
                                    </td>

                                    <td class="text-right font-weight-bold text-dark">
                                        @sale.TotalAmount.ToString("#,##0") <small class="text-muted">Ks</small>
                                    </td>

                                    <td class="text-center">
                                        @if (sale.Status == "Completed" || sale.Status == "Paid")
                                        {
                                            <span class="badge badge-success px-2 py-1"><i class="fas fa-check-circle mr-1"></i>@sale.Status</span>
                                        }
                                        else if (sale.Status == "Voided")
                                        {
                                            <span class="badge badge-danger px-2 py-1"><i class="fas fa-times-circle mr-1"></i>@sale.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning px-2 py-1">@sale.Status</span>
                                        }
                                    </td>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <td>
                                            <span class="text-muted"><i class="fas fa-user-tag mr-1"></i> @sale.CashierName</span>
                                        </td>
                                    }

                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="SaleDetails" asp-route-id="@sale.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>

                                            @if (User.IsInRole("Admin") && sale.Status != "Voided")
                                            {
                                                <a asp-action="VoidSale" asp-route-id="@sale.Id"
                                                   class="btn btn-sm btn-outline-danger"
                                                   title="Void Sale"
                                                 >
                                                    <i class="fas fa-ban"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        @if (Model != null && Model.TotalPages > 0)
        {
            <div class="card-footer bg-white border-top-0 d-flex flex-column flex-sm-row justify-content-between align-items-center">

                <div class="text-muted text-sm mb-2 mb-sm-0">
                    Showing Page <strong>@Model.PageNumber</strong> of <strong>@Model.TotalPages</strong>
                    (Total @Model.TotalCount items)
                </div>

                <nav aria-label="Product pagination">
                    <ul class="pagination pagination-sm m-0">

                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="ViewSaleTransactions" asp-route-page="@(Model.PageNumber - 1)" asp-route-searchString="@ViewBag.CurrentSearch">Previous</a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="ViewSaleTransactions" asp-route-page="@i" asp-route-searchString="@ViewBag.CurrentSearch">@i</a>
                            </li>
                        }

                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="ViewSaleTransactions" asp-route-page="@(Model.PageNumber + 1)" asp-route-searchString="@ViewBag.CurrentSearch">Next</a>
                        </li>

                    </ul>
                </nav>

            </div>
        }
    </div>
</div>