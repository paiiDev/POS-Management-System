@using POS.Shared.DTOs.Sales
@model SaleDto

@{
    ViewData["Title"] = "Void Sale";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-6">

            @if (!string.IsNullOrWhiteSpace(ViewBag.Error))
            {
                <div class="alert alert-danger" role="alert">
                    @ViewBag.Error
                </div>
            }

            <div class="card shadow-sm border-danger">

                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Void Sale</h4>
                </div>

                <div class="card-body">

                    <div class="mb-3">

                        <label class="fw-bold">Invoice No</label>
                        <p>@Model.InvoiceNo</p>

                    </div>

                    <div class="mb-3">

                        <label class="fw-bold">Total Amount</label>
                        <p>@Model.TotalAmount.ToString("#,##0 Ks")</p>

                    </div>

                    <form asp-action="VoidSaleConfirmed"
                          method="post">

                        <input type="hidden"
                               name="SaleId"
                               value="@Model.Id" />

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Void Reason
                            </label>

                            <textarea name="Reason"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Enter reason for voiding this sale..."></textarea>

                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-action="VoidSale"
                               asp-route-id="@Model.Id"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-danger">
                                Void Sale
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>